# ──────────────────────────────────────────────────────────────────────────────
# GarbaVerse — environment variables
# Copy to .env.local for local dev. Add every key to Vercel → Project → Settings
# → Environment Variables before deploying.
# ──────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for emails, QR links, calendar links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_* keys until go-live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Account & Settings → Webhooks → the secret you typed when creating
# the webhook pointing at https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a verified domain in Resend. e.g. "GarbaVerse <passes@garbaverse.in>"
EMAIL_FROM="GarbaVerse <passes@yourdomain.com>"
# Where "reply" goes (organiser inbox)
EMAIL_REPLY_TO=studentsurge@gmail.com

# ── Security ──────────────────────────────────────────────────────────────────
# 32+ random bytes, base64 or hex. Signs booking IDs / QR payloads / admin cookie.
#   openssl rand -hex 32
BOOKING_SIGNING_SECRET=replace-with-64-hex-chars
# Admin dashboard password (/admin). Use a long passphrase.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Protects /api/cron/expire. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# REQUIRED in production — the endpoint refuses to run without it.
CRON_SECRET=replace-with-random-string
